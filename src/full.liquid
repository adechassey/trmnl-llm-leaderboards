{%- comment -%}
  Full screen (800x480 on the OG, 1040x780 on the TRMNL X, 780x1040 in portrait): the selected
  leaderboards side by side (up to 3), stacked in portrait. Each board lists as many rows as fit
  its height (Overflow engine) and spreads them over two columns when it has the width: a
  single board on every screen, every board in portrait. With one or two boards the
  organisation follows the model name on large screens in landscape (the only case with room
  for it). With three boards the price column and legend only fit on large screens.
{%- endcomment -%}
{%- if boards.size > 2 -%}
  {%- assign cols = 1 -%}{%- assign cols_lg = 1 -%}{%- assign cols_lg_portrait = 2 -%}
  {%- assign board_class = "portrait:h--[32cqh]" -%}{%- assign compact = true -%}{%- assign price_lg_only = true -%}{%- assign org_class = "hidden" -%}
{%- else -%}
  {%- if boards.size > 1 -%}
    {%- assign cols = 1 -%}{%- assign cols_lg = 1 -%}{%- assign cols_lg_portrait = 2 -%}{%- assign board_class = "portrait:h--[48cqh]" -%}
  {%- else -%}
    {%- assign cols = 2 -%}{%- assign cols_lg = 2 -%}{%- assign cols_lg_portrait = 2 -%}{%- assign board_class = "portrait:h--full" -%}
  {%- endif -%}
  {%- assign compact = false -%}{%- assign price_lg_only = false -%}{%- assign org_class = "hidden lg:inline lg:portrait:hidden" -%}
{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--row layout--stretch portrait:layout--col gap--large">
  {%- for b in boards -%}
    {% render 'board', board: b, cols: cols, cols_lg: cols_lg, cols_lg_portrait: cols_lg_portrait, board_class: board_class, compact: compact, short_header: false, price_lg_only: price_lg_only, org_class: org_class, hl: hl, hl_size: hl_size, date_fmt: date_fmt, t_no_models: t_no_models, t_price: t_price, t_new: t_new %}
  {%- endfor -%}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: title_instance %}
