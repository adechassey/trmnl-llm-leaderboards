{%- comment -%}
  Quadrant (400x240 on the OG, 520x390 on the TRMNL X, 390x520 in portrait): the first
  leaderboard only, as many rows as fit, with a short header (source and date).
{%- endcomment -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--col layout--stretch">
  {% render 'board', board: boards[0], cols: 1, cols_lg: 1, cols_lg_portrait: 1, board_class: "h--full", compact: false, short_header: true, price_lg_only: false, org_class: "hidden lg:inline lg:portrait:hidden", hl: hl, hl_size: hl_size, date_fmt: date_fmt, t_no_models: t_no_models, t_price: t_price, t_new: t_new %}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
