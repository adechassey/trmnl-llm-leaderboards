{%- comment -%}
  Quadrant (400x240 on the OG, twice that on TRMNL X): the first leaderboard only, 5 rows on
  the OG and up to 8 on large screens.
{%- endcomment -%}
{%- assign n = max_models -%}
{%- if n > 8 -%}{%- assign n = 8 -%}{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--col layout--top layout--stretch-x">
  {%- assign b = boards[0] -%}
  {% render 'board', board: b, n: n, cap: 5, compact: false, price_class: "", hl: hl, hl_size: hl_size, org_class: "hidden", table_class: "table--xsmall", date_fmt: date_fmt, t_model: t_model, t_no_models: t_no_models, t_price: t_price, t_new: t_new %}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
