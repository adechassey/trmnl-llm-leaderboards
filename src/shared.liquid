{%- comment -%}
  LLM Leaderboards: data preparation.

  TRMNL prepends this file to every layout. It defines the shared `title_bar` and `board`
  templates and the Liquid variables used by full / half_* / quadrant:
    - error         : error message ("" when at least one board can be shown)
    - boards        : from the Serverless function src/transform.py, one entry per selected
                      leaderboard: title, source (domain), date (ISO or ""), unit, has_price,
                      rows (rank, model, org, score, price, new) and error; the function
                      already applies the "Models per leaderboard" cap
    - hl, hl_size   : lowercase words from the "Highlight" field
    - screen_title  : title bar text
    - now_local     : render time in the user's time zone
    - lang, t_*     : on-screen language (en / fr) and the translated labels

  Fields read by the Serverless function rather than by the markup: board_1, board_2,
  board_3, max_models, open_weights_only, show_prices, aa_api_key, livebench_version (see
  src/transform.py).
{%- endcomment -%}


{%- comment -%}
  Shared title bar with a small podium icon (inline SVG data URI, black on the bar's background)
  so the plugin is recognisable in a mashup; the closing tag must be written exactly {% endtemplate %}
{%- endcomment -%}
{% template title_bar %}
<div class="title_bar">
  <img class="image" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='2' y='12' width='6' height='10' rx='1'/%3E%3Crect x='9' y='5' width='6' height='17' rx='1'/%3E%3Crect x='16' y='15' width='6' height='7' rx='1'/%3E%3C/svg%3E">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ instance }}</span>
</div>
{% endtemplate %}

{%- comment -%}
  One leaderboard: a header line (title; unit, price legend, source and date), then one item
  per row (the simple variant: the framework's meta bar and index are too narrow for two-digit
  ranks): rank, model, score and price ("10/50" = $10 per million input tokens, $50 per
  million output tokens) when the function found prices, and a "new" badge on models released
  in the last two weeks. Scores in % or hours carry their unit; the others (Elo, ECI, Index)
  name it in the header. The rows sit in a framework Columns container: the Overflow engine
  shows as many as fit the board's height and splits them over up to `cols` columns
  (`cols_lg` on large screens, `cols_lg_portrait` on large screens in portrait). Text steps
  up one size on large screens (lg:).
  Arguments: board, cols, cols_lg, cols_lg_portrait, board_class (extra classes of the board:
  its height when the layout is a column, see below), compact (source line under the title,
  for narrow boards), short_header (source and date only, for mashup slots), price_lg_only
  (price column and legend only on large screens), org_class (visibility classes of the
  organisation after the model name, e.g. "hidden lg:inline lg:portrait:hidden" = large
  screens in landscape only, "hidden" = never), hl + hl_size (highlight words), date_fmt,
  t_no_models, t_price, t_new.
  The enclosing layout stretches the board (layout--stretch), which gives the Overflow engine
  its height budget. In a column layout (stacked boards, portrait) a board also needs an
  explicit height (h--full, or a share such as h--[48cqh] of the layout's height) so that
  flexbox may shrink it below the height of its rows.
{%- endcomment -%}
{% template board %}
{%- assign suffix = "" -%}
{%- assign meta = "" -%}
{%- if board.unit == "%" or board.unit == "h" -%}{%- assign suffix = board.unit -%}{%- else -%}{%- assign meta = board.unit -%}{%- endif -%}
{%- assign source_line = board.source -%}
{%- if board.date != blank -%}{%- assign date_text = board.date | date: date_fmt -%}{%- assign source_line = source_line | append: " · " | append: date_text -%}{%- endif -%}
{%- assign priced_line = source_line -%}
{%- if short_header != true -%}
  {%- if board.has_price -%}{%- assign priced_line = t_price | append: " · " | append: source_line -%}{%- endif -%}
  {%- if meta != "" -%}{%- assign source_line = meta | append: " · " | append: source_line -%}{%- assign priced_line = meta | append: " · " | append: priced_line -%}{%- endif -%}
  {%- if price_lg_only == false -%}{%- assign source_line = priced_line -%}{%- endif -%}
{%- endif -%}
<div class="flex flex--col gap--small {{ board_class }}">
  {%- if compact -%}
  <div class="flex flex--col flex--left w--full">
    <span class="title title--small lg:title--base">{{ board.title }}</span>
    <span class="label label--small lg:label--base{% if source_line != priced_line %} lg:hidden{% endif %}">{{ source_line }}</span>
    {%- if source_line != priced_line -%}<span class="label label--base hidden lg:inline">{{ priced_line }}</span>{%- endif -%}
  </div>
  {%- else -%}
  <div class="flex flex--row flex--between flex--bottom gap--small w--full">
    <span class="title title--small lg:title--base{% if short_header %} lg:portrait:title--small{% endif %}">{{ board.title }}</span>
    <span class="label label--small lg:label--base text--right{% if source_line != priced_line %} lg:hidden{% endif %}">{{ source_line }}</span>
    {%- if source_line != priced_line -%}<span class="label label--base text--right hidden lg:inline">{{ priced_line }}</span>{%- endif -%}
  </div>
  {%- endif -%}
  {%- if board.error != blank -%}
  <span class="label label--small lg:label--base w--full">{{ board.error }}</span>
  {%- elsif board.rows.size == 0 -%}
  <span class="label label--small lg:label--base w--full">{{ t_no_models }}</span>
  {%- else -%}
  <div class="columns" data-overflow-max-cols="{{ cols }}" data-overflow-max-cols-lg="{{ cols_lg }}" data-overflow-max-cols-lg-portrait="{{ cols_lg_portrait }}">
    <div class="column">
      {%- for r in board.rows -%}
        {%- assign hit = false -%}
        {%- if hl_size > 0 -%}
          {%- assign m = r.model | downcase -%}
          {%- for h in hl -%}{%- if h != "" and m contains h -%}{%- assign hit = true -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
      <div class="item">
        <div class="content w--full">
          <div class="flex flex--center-y gap--small w--full">
            <div class="w--5 lg:w--7 text--right shrink-0"><span class="label label--small lg:label--base text--bold">{{ r.rank }}</span></div>
            <div class="flex flex--center-y gap--xsmall grow">
              <span class="label label--small lg:label--xlarge{% if hit %} label--filled{% endif %}">{{ r.model }}</span>
              {%- if r.org != blank -%}<span class="label label--small lg:label--large label--gray {{ org_class }}">{{ r.org }}</span>{%- endif -%}
              {%- if r.new -%}<span class="label label--small lg:label--base label--underline">{{ t_new }}</span>{%- endif -%}
            </div>
            <span class="value value--xxsmall lg:value--small value--tnums shrink-0">{{ r.score }}{{ suffix }}</span>
            {%- if board.has_price -%}<div class="w--16 lg:w--20 text--right shrink-0{% if price_lg_only %} hidden lg:block{% endif %}"><span class="label label--small lg:label--base">{{ r.price }}</span></div>{%- endif -%}
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</div>
{% endtemplate %}

{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}

{%- comment -%} Render clock (UTC seconds) and local time {%- endcomment -%}
{%- assign now_ts = trmnl.system.timestamp_utc -%}
{%- if now_ts == blank -%}{%- assign now_ts = "now" | date: "%s" -%}{%- endif -%}
{%- assign now_ts = now_ts | plus: 0 -%}
{%- assign utc_offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign now_local = now_ts | plus: utc_offset | date: "%H:%M" -%}

{%- comment -%} Highlight words: lowercase, trimmed around the commas {%- endcomment -%}
{%- assign hl_raw = cf.highlight | default: "" | downcase | strip | replace: " ,", "," | replace: ", ", "," -%}
{%- if hl_raw == "" -%}
  {%- assign hl_size = 0 -%}
  {%- assign hl = "" | split: "," -%}
{%- else -%}
  {%- assign hl = hl_raw | split: "," -%}
  {%- assign hl_size = hl.size -%}
{%- endif -%}

{%- comment -%}
  On-screen language: the `language` field (auto / en / fr). "auto" follows the TRMNL
  account locale (trmnl.user.locale). Every label used by the layouts is a t_* variable;
  add a language by adding a branch here. Error messages from transform.py stay in English.
{%- endcomment -%}
{%- assign lang = cf.language | default: "auto" | downcase -%}
{%- if lang == "auto" or lang == "" -%}
  {%- assign lang = trmnl.user.locale | default: "en" | downcase | slice: 0, 2 -%}
{%- endif -%}
{%- if lang == "fr" -%}
  {%- assign t_title = "Classements LLM" -%}
  {%- assign t_no_models = "Aucun modèle" -%}
  {%- assign t_updated = "Mis à jour" -%}
  {%- assign t_unavailable = "Données indisponibles" -%}
  {%- assign t_no_data = "Pas de données : la fonction Serverless du plugin n'a pas répondu." -%}
  {%- assign t_price = "$ in/out" -%}
  {%- assign t_new = "nouveau" -%}
  {%- assign date_fmt = "%-d %b" -%}
{%- else -%}
  {%- assign lang = "en" -%}
  {%- assign t_title = "LLM Leaderboards" -%}
  {%- assign t_no_models = "No models" -%}
  {%- assign t_updated = "Updated" -%}
  {%- assign t_unavailable = "Data unavailable" -%}
  {%- assign t_no_data = "No data: the plugin's Serverless function did not respond." -%}
  {%- assign t_price = "$ in/out" -%}
  {%- assign t_new = "new" -%}
  {%- assign date_fmt = "%b %-d" -%}
{%- endif -%}

{%- comment -%} Serverless function output: `boards`, `error` {%- endcomment -%}
{%- assign api_error = error | default: "" -%}
{%- assign error = "" -%}
{%- if boards == nil -%}
  {%- assign error = t_no_data -%}
{%- elsif boards.size == 0 -%}
  {%- assign error = api_error -%}
  {%- if error == "" -%}{%- assign error = t_no_models -%}{%- endif -%}
{%- endif -%}

{%- assign screen_title = cf.title | default: "" | strip -%}
{%- if screen_title == "" -%}{%- assign screen_title = t_title -%}{%- endif -%}
{%- assign title_instance = t_updated | append: " " | append: now_local -%}
