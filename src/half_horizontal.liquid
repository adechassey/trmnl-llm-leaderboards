{%- comment -%}
  Horizontal half (800x240 on the OG, 1040x390 on the TRMNL X, 780x520 in portrait): the first
  two leaderboards side by side, as many rows as fit, with a short header (source and date).
  A single leaderboard gets the whole width and spreads its rows over two columns.
{%- endcomment -%}
{%- if boards.size > 1 -%}
  {%- assign cols = 1 -%}
{%- else -%}
  {%- assign cols = 2 -%}
{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--row layout--stretch gap--large">
  {%- for b in boards limit: 2 -%}
    {% render 'board', board: b, cols: cols, cols_lg: cols, cols_lg_portrait: cols, board_class: "", compact: false, short_header: true, price_lg_only: false, org_class: "hidden lg:inline lg:portrait:hidden", hl: hl, hl_size: hl_size, date_fmt: date_fmt, t_no_models: t_no_models, t_price: t_price, t_new: t_new %}
  {%- endfor -%}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
