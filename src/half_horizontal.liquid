{%- comment -%}
  Horizontal half (800x240): the first two leaderboards side by side, 5 rows each on the OG,
  up to 8 on large screens.
{%- endcomment -%}
{%- assign n = max_models -%}
{%- if n > 8 -%}{%- assign n = 8 -%}{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--row layout--stretch gap--large">
  {%- for b in boards limit: 2 -%}
    {% render 'board', board: b, n: n, cap: 5, compact: false, hl: hl, hl_size: hl_size, show_org: false, table_class: "table--xsmall", date_fmt: date_fmt, t_model: t_model, t_no_models: t_no_models %}
  {%- endfor -%}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
