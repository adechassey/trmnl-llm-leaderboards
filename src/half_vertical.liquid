{%- comment -%}
  Vertical half (400x480 on the OG, 520x780 on the TRMNL X, 390x1040 in portrait): the first
  two leaderboards stacked, half the height each (the explicit height lets the flex column
  shrink a board below its content), as many rows as fit, with a short header (source and
  date). A single leaderboard gets the whole height.
{%- endcomment -%}
{%- if boards.size > 1 -%}
  {%- assign board_class = "h--[48cqh]" -%}
{%- else -%}
  {%- assign board_class = "h--full" -%}
{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--col layout--stretch">
  {%- for b in boards limit: 2 -%}
    {% render 'board', board: b, cols: 1, cols_lg: 1, cols_lg_portrait: 1, board_class: board_class, compact: false, short_header: true, price_lg_only: false, org_class: "hidden lg:inline lg:portrait:hidden", hl: hl, hl_size: hl_size, date_fmt: date_fmt, t_no_models: t_no_models, t_price: t_price, t_new: t_new %}
  {%- endfor -%}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
