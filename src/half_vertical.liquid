{%- comment -%}
  Vertical half (400x480): the first two leaderboards stacked, 5 rows each on the OG and up
  to 8 on large screens. A single leaderboard gets the whole height: 12 rows on the OG.
{%- endcomment -%}
{%- assign n = max_models -%}
{%- if boards.size > 1 -%}
  {%- assign cap = 5 -%}
  {%- if n > 8 -%}{%- assign n = 8 -%}{%- endif -%}
{%- else -%}
  {%- assign cap = 12 -%}
{%- endif -%}
{%- if error != "" -%}
<div class="layout layout--col layout--center">
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
</div>
{%- else -%}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  {%- for b in boards limit: 2 -%}
    {% render 'board', board: b, n: n, cap: cap, compact: false, hl: hl, hl_size: hl_size, show_org: false, table_class: "table--xsmall", date_fmt: date_fmt, t_model: t_model, t_no_models: t_no_models %}
  {%- endfor -%}
</div>
{%- endif -%}

{% render 'title_bar', title: screen_title, instance: now_local %}
